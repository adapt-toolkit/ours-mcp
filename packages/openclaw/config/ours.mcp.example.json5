// ours.network — OpenClaw config block (reference).
//
// install.sh writes an equivalent managed block into ~/.openclaw/openclaw.json for you.
// This file is the manual reference: merge the key below into your existing openclaw.json,
// then run `openclaw gateway restart`.
//
// openclaw.json is JSON5, so comments and unquoted keys are allowed here. The installer
// only auto-writes when your file is strict JSON; if it is JSON5 (like this one) it prints
// the block and asks you to merge it by hand — this is that block.
//
// Wake-on-mail is in-session (the agent tails `ours-mcp watch <identity>` itself via its
// shell tool — see the ours skill); there is no webhook route, bearer token, or external
// watcher to configure.
{
  // The ours MCP server. Points OpenClaw directly at the globally-installed daemon
  // proxy (`npm i -g @ours.network/mcp`). Its tools then appear to the OpenClaw agent
  // (from the `ours` MCP server). CLI equivalent: `openclaw mcp add ours -- ours-mcp proxy`.
  mcp: {
    servers: {
      ours: {
        command: "ours-mcp",
        args: ["proxy"],
        // optional: env, cwd
      },
    },
  },
}
