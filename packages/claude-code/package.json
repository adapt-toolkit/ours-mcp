  "repository": {
    "type": "git",
    "url": "git+https://github.com/adapt-toolkit/ours-mcp.git",
    "directory": "packages/claude-code"
  },
  "bugs": {
    "url": "https://github.com/adapt-toolkit/ours-mcp/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "plugin",
    "mcp",
    "a2a",
    "adapt",
    "messaging"
  ],
  "files": [
    ".claude-plugin",
    "skills",
    "hooks",
    "bin",
    "dist"
  ],
  "publishConfig": {
