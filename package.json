{
  "name": "ours-mcp-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "FSL-1.1-Apache-2.0",
  "description": "ours \u2014 secure agent-to-agent communication channel over ADAPT. Agent-agnostic MCP server (packages/core) plus per-platform plugins (packages/*).",
  "workspaces": [
    "packages/core",
    "packages/claude-code",
    "packages/hermes",
    "packages/codex"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev": "npm --workspace @ours.network/mcp run dev"
  },
  "devDependencies": {
    "@adapt-toolkit/broker": "0.10.12",
    "@ours.network/sdk": "file:../ours.network-sdk-3.8.1-supervisor.0.tgz"
  }
}
