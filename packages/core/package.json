{
  "name": "@ours.network/mcp",
  "version": "1.1.2-supervisor.0",
  "description": "MCP adapter for the shared ours daemon, with application-local identity bookkeeping and secure agent-to-agent messaging tools over stdio.",
  "type": "module",
  "license": "FSL-1.1-Apache-2.0",
  "author": "Adapt Toolkit",
  "homepage": "https://github.com/adapt-toolkit/ours-mcp/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adapt-toolkit/ours-mcp.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/adapt-toolkit/ours-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "a2a",
    "adapt",
    "e2e",
    "messaging"
  ],
  "bin": {
    "ours-mcp": "dist/cli.js"
  },
  "exports": {
    "./dist/*": "./dist/*",
    "./server": {
      "types": "./dist/types/mcp/server.d.ts",
      "default": "./dist/server.js"
    },
    "./application-identities": {
      "types": "./dist/types/application-identities.d.ts",
      "default": "./dist/application-identities.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "OURS_BUILD_DEV=1 node build.mjs",
    "build:tsc": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts proxy",
    "prepublishOnly": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/managed-server.test.mjs && node test/application-identities.test.mjs && node test/local-files.test.mjs && node test/cli-delegation.test.mjs && node test/inbox-push.test.mjs && node test/contact-lines.test.mjs && node test/env-bind-identity.test.mjs && node test/proxy-exit-on-stdin-eof.test.mjs && node test/proxy-dead-stderr.test.mjs && node test/session-end-temp-cleanup.test.mjs && node test/host-profile.test.mjs && node test/container.test.mjs",
    "test:external-profile": "node test/native-profile-session.test.mjs && node test/external-profile-stdio-refresh.test.mjs"
  },
  "dependencies": {
    "@ours.network/sdk": "3.8.1-supervisor.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "@ours.network/cli": "2.8.1-nightly.7",
    "@ours.network/daemon": "3.8.1-nightly.1"
  }
}
