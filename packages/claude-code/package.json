    "build:dev": "OURS_BUILD_DEV=1 node build.mjs",
    "prepublishOnly": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test/proxy-resolve.test.mjs"
  },
  "dependencies": {
    "@ours.network/mcp": "0.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.5.4"
