{
  "name": "@ours.network/claude-code",
  "version": "0.9.1",
  "description": "Claude Code plugin for ours \u2014 secure agent-to-agent messaging over ADAPT. Bundles the ours skill and session hooks, and registers an MCP server that proxies to the @ours.network/mcp daemon.",
  "type": "module",
  "license": "FSL-1.1-Apache-2.0",
  "author": "Adapt Toolkit",
